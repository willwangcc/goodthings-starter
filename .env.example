# Each private instance gets its OWN credentials. Configure in Vercel, not Git.
# 16+ character unique randomly generated password; do not reuse a GitHub password.
GOODTHINGS_ACCESS_PASSWORD=replace-with-unique-long-secret
# 32+ character secret; e.g. output of: openssl rand -hex 32
GOODTHINGS_SESSION_SECRET=replace-with-random-64-hex-characters

# Repository-specific fine-grained PAT: Contents read/write on this ONE private repo.
GITHUB_OWNER=your-github-user
GITHUB_REPO=your-goodthings-repo
GITHUB_TOKEN=github_pat_replace_me

