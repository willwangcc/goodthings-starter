{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opportunity.schema.json",
  "title": "Good Things Opportunity v1",
  "description": "Canonical facts about one opportunity. User-specific fit belongs in the feed wrapper, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "identity", "summary", "lifecycle", "geography", "benefits", "eligibility", "participation", "application", "taxonomy", "provenance", "updated_at"],
  "properties": {
    "schema_version": { "const": "opportunity.v1" },
    "id": { "type": "string", "minLength": 1 },
    "identity": { "type": "object", "additionalProperties": false, "required": ["kind", "title", "organizer"], "properties": { "kind": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "organizer": { "type": "string", "minLength": 1 } } },
    "summary": { "type": "object", "additionalProperties": false, "required": ["short"], "properties": { "short": { "type": "string", "minLength": 1 }, "long": { "type": ["string", "null"] } } },
    "lifecycle": { "type": "object", "additionalProperties": false, "required": ["status", "opens_at", "deadline_at", "starts_at", "ends_at"], "properties": { "status": { "enum": ["upcoming", "open", "rolling", "closed", "paused", "unknown"] }, "opens_at": { "type": ["string", "null"], "format": "date-time" }, "deadline_at": { "type": ["string", "null"], "format": "date-time" }, "starts_at": { "type": ["string", "null"], "format": "date-time" }, "ends_at": { "type": ["string", "null"], "format": "date-time" } } },
    "geography": { "type": "object", "additionalProperties": false, "required": ["mode", "locations"], "properties": { "mode": { "enum": ["onsite", "remote", "hybrid", "residency", "multi_location", "unknown"] }, "locations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": { "city": { "type": ["string", "null"] }, "region": { "type": ["string", "null"] }, "country": { "type": ["string", "null"] } } } } } },
    "benefits": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["type", "amount", "min_amount", "max_amount", "currency", "coverage", "note"], "properties": { "type": { "type": "string" }, "amount": { "type": ["number", "null"] }, "min_amount": { "type": ["number", "null"] }, "max_amount": { "type": ["number", "null"] }, "currency": { "type": ["string", "null"] }, "coverage": { "type": ["string", "null"] }, "note": { "type": ["string", "null"] } } } },
    "eligibility": { "type": "object", "additionalProperties": false, "required": ["criteria"], "properties": { "criteria": { "type": "array", "items": { "type": "object", "additionalProperties": true, "required": ["id", "description"], "properties": { "id": { "type": "string" }, "description": { "type": "string" }, "required": { "type": "boolean" } } } } } },
    "participation": { "type": "object", "additionalProperties": false, "required": ["duration", "minimum_commitment", "notes"], "properties": { "duration": { "type": ["string", "null"] }, "minimum_commitment": { "type": ["string", "null"] }, "notes": { "type": "array", "items": { "type": "string" } } } },
    "application": { "type": "object", "additionalProperties": false, "required": ["method", "submission_url", "account_requirement", "languages", "submission_limit", "human_authorship_required", "final_confirmation_required", "requirements"], "properties": { "method": { "enum": ["external_form", "email", "portal", "api", "other", "unknown"] }, "submission_url": { "type": ["string", "null"], "format": "uri" }, "account_requirement": { "type": ["string", "null"] }, "languages": { "type": "array", "items": { "type": "string" } }, "submission_limit": { "type": ["string", "null"] }, "human_authorship_required": { "type": ["boolean", "null"] }, "final_confirmation_required": { "type": ["boolean", "null"] }, "requirements": { "type": "array", "items": { "type": "object", "additionalProperties": true } } } },
    "taxonomy": { "type": "object", "additionalProperties": false, "required": ["topics", "audiences", "tags"], "properties": { "topics": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "audiences": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["primary_source_url", "publisher", "retrieved_at", "verified_at", "verification_status", "notes"], "properties": { "primary_source_url": { "type": "string", "format": "uri" }, "publisher": { "type": ["string", "null"] }, "retrieved_at": { "type": "string", "format": "date-time" }, "verified_at": { "type": ["string", "null"], "format": "date-time" }, "verification_status": { "enum": ["verified", "partial", "source_conflict", "stale", "unverified"] }, "notes": { "type": "array", "items": { "type": "string" } } } },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
