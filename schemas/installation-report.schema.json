{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "installation-report.schema.json",
  "title": "Good Things Installation Report v1 — private instance only",
  "description": "Installation evidence is private to the participant. Never commit real reports into the public starter repository.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "recorded_on",
    "installation_result",
    "last_verified_state",
    "starter_revision",
    "session",
    "metrics",
    "checks",
    "frictions",
    "public_issue_links"
  ],
  "properties": {
    "schema_version": {
      "const": "installation-report.v1"
    },
    "report_id": {
      "type": "string",
      "pattern": "^install-[0-9]{8}-[A-Za-z0-9_-]{3,24}$"
    },
    "recorded_on": {
      "type": "string",
      "format": "date"
    },
    "installation_result": {
      "enum": [
        "PASS",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "last_verified_state": {
      "enum": [
        "UNKNOWN",
        "REPO_READY",
        "DATA_READY",
        "APP_READY",
        "FEEDBACK_READY",
        "SCHEDULE_READY",
        "COMPLETE"
      ]
    },
    "starter_revision": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "finished_at",
        "chat_mode",
        "github_access",
        "vercel_access",
        "scheduled_task_access"
      ],
      "properties": {
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "chat_mode": {
          "enum": [
            "ordinary_chat",
            "work",
            "unknown"
          ]
        },
        "github_access": {
          "enum": [
            "verified",
            "unverified",
            "unavailable"
          ]
        },
        "vercel_access": {
          "enum": [
            "verified",
            "unverified",
            "unavailable"
          ]
        },
        "scheduled_task_access": {
          "enum": [
            "verified",
            "unverified",
            "unavailable"
          ]
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsed_minutes",
        "manual_interventions",
        "custom_code_edits"
      ],
      "properties": {
        "elapsed_minutes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "manual_interventions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "custom_code_edits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "status",
          "evidence"
        ],
        "properties": {
          "test_id": {
            "type": "string",
            "pattern": "^T(0[1-9]|1[0-3])$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "PENDING",
              "BLOCKED",
              "NOT_TESTED"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          }
        }
      }
    },
    "frictions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "friction_id",
          "stage",
          "category",
          "summary",
          "expected",
          "observed",
          "reproduction_steps",
          "recovery",
          "minutes_lost",
          "severity",
          "status",
          "issue_url"
        ],
        "properties": {
          "friction_id": {
            "type": "string",
            "pattern": "^F[0-9]{2,4}$"
          },
          "stage": {
            "enum": [
              "START",
              "REPO_READY",
              "DATA_READY",
              "APP_READY",
              "FEEDBACK_READY",
              "SCHEDULE_READY",
              "COMPLETE",
              "REVIEW"
            ]
          },
          "category": {
            "enum": [
              "permissions",
              "authentication",
              "deployment",
              "scheduled_task",
              "data",
              "interface",
              "documentation",
              "tool_unavailable",
              "other"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 5,
            "maxLength": 240
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "observed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "reproduction_steps": {
            "type": "array",
            "maxItems": 15,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "recovery": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "minutes_lost": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "severity": {
            "enum": [
              "blocking",
              "high",
              "medium",
              "low"
            ]
          },
          "status": {
            "enum": [
              "unresolved",
              "workaround",
              "resolved",
              "unverified"
            ]
          },
          "issue_url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://github\\.com/willwangcc/goodthings-starter/issues/[0-9]+$"
          }
        }
      }
    },
    "public_issue_links": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://github\\.com/willwangcc/goodthings-starter/issues/[0-9]+$"
      }
    }
  }
}
